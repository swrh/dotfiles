# .profile

# Configure default locale settings.
[ -n "$LANG" ] || export LANG="C"

# The default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
umask 022

[ ! -d "$HOME/bin" ] || PATH="$HOME/bin:$PATH"
[ ! -d "$HOME/.local/bin" ] || PATH="$HOME/.local/bin:$PATH"
[ ! -d "$HOME/.docker/bin" ] || PATH="$HOME/.docker/bin:$PATH"
[ ! -d "$HOME/.fzf/bin" ] || PATH="$HOME/.fzf/bin:$PATH"
[ ! -d "$HOME/.bun" ] || { export BUN_INSTALL="$HOME/.bun"; PATH="$BUN_INSTALL/bin:$PATH"; }

export LESS="-R"

# Require TLS with certificate and hostname verification for PostgreSQL clients
export PGSSLMODE="verify-full"

[ ! -r "$HOME/.local/bin/env" ] || . "$HOME/.local/bin/env"

# Load drop-ins from ~/.profile.d
[ -z "$ZSH_VERSION" ] || setopt null_glob
for _f in "$HOME"/.profile.d/*.sh; do
	[ ! -r "$_f" ] || . "$_f"
done
[ -z "$ZSH_VERSION" ] || unsetopt null_glob
unset _f

# include local .profile if it exists
[ ! -r "$HOME/.profile-local" ] || . "$HOME/.profile-local"

