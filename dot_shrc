# .shrc

# Skip if not running interactively
[ ! -z "${PS1}" -o "${-#*i}" != "${-}" ] || return 0

# zsh only: source the output of a slow init command from a cache file.
# Usage: _cached_eval NAME COMMAND [ARGS...]
# The cache is rebuilt when the resolved path of COMMAND changes (e.g. a
# Homebrew upgrade moves it to a new Cellar version dir). To force a rebuild
# of everything, run `zsh-cache-clear`.
if [ -n "$ZSH_VERSION" ]; then
	_zsh_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
	_cached_eval()
	{
		local name=$1; shift
		local bin=${commands[$1]:-$1}
		bin=${bin:A}
		[[ -x $bin ]] || return 1
		local cache="$_zsh_cache_dir/$name.zsh" header="# src: $bin" first=
		[[ ! -r $cache ]] || IFS= read -r first < "$cache"
		if [[ $first != $header ]]; then
			mkdir -p "$_zsh_cache_dir" || return 1
			{ print -r -- "$header"; command "$@"; } >| "$cache.$$" \
				&& mv -f "$cache.$$" "$cache" || { rm -f "$cache.$$"; return 1; }
		fi
		source "$cache"
	}
	alias zsh-cache-clear='rm -rf "$_zsh_cache_dir"'
fi

# Enable color support for `ls`
_lsargs=""
if ls -d -v / >/dev/null 2>&1; then
	_lsargs="$_lsargs -v"
fi
if ls -d --sort=name / >/dev/null 2>&1; then
	_lsargs="$_lsargs --sort=name"
fi
if [ "$TERM" != "dumb" ]; then
	if command -v dircolors >/dev/null; then
		eval "`dircolors -b`"
	fi

	if ls -d --color=auto / >/dev/null 2>&1; then
		_lsargs="$_lsargs --color=auto"
	elif ls -d -G / >/dev/null 2>&1; then
		_lsargs="$_lsargs -G"
	fi
fi
alias l="ls -laF$_lsargs"
unset _lsargs

# Enable color support for `grep'
if [ "$TERM" != "dumb" ] && grep --color=auto -qm1 . /etc/hosts >/dev/null 2>&1; then
	alias grep="grep --color=auto"
	alias fgrep="grep --color=auto -F"
fi

# More aliases.
alias scr="screen -D -RR -s -$SHELL"
alias t='env -C "$HOME" tmux new -As0'

if command -v git >/dev/null; then
	alias cd-git='cd "$(git rev-parse --show-toplevel)"'
fi

if command -v chezmoi >/dev/null; then
	alias cm='chezmoi'
	alias cmgit='chezmoi git --'
	alias cd-chezmoi='cd ~/.local/share/chezmoi'
fi

if command -v batcat >/dev/null; then
	alias bat='batcat'
fi

if command -v fdfind >/dev/null; then
	alias fd='fdfind'
fi

# Set my favorite editor
if command -v nvim >/dev/null; then
	export EDITOR="nvim"
	alias cd-nvim='cd ~/.config/nvim'
	alias vicb='nvim -n +"%d _ | put + | 1d _" +"set buftype=acwrite" +"file clipboard://" +'\''au BufWriteCmd <buffer> let @+=join(getline(1,"$"),"\n") | set nomod'\'
elif command -v vim >/dev/null; then
	export EDITOR="vim"
	alias vicb='vim -n +"%d _ | put + | 1d _" +"set buftype=acwrite" +"file clipboard://" +'\''au BufWriteCmd <buffer> let @+=join(getline(1,"$"),"\n") | set nomod'\'
elif command -v vi >/dev/null; then
	export EDITOR="vi"
fi

# Set my favorite pager
if command -v less >/dev/null; then
	export PAGER="less"
fi

# https://worktrunk.dev/
if command -v wt >/dev/null; then
	alias wtsw='wt switch'
fi

# Set `vi' mode
set -o vi

# Set PS1
if [ -n "$BASH_VERSION" ]; then
	PS1='\h\$ '
	case "$TERM" in
	xterm*|rxvt*|screen*)
		_ps1="\\u@\\h: \\w"
		_tty="`tty 2>/dev/null`"
		[ $? -ne 0 ] || _ps1="$_ps1 (${_tty#/dev/})"
		unset _tty
		PS1="$PS1\\[\\e]0;$_ps1\\a\\]"
		case "$TERM" in
		screen*)
			PS1="$PS1\\[\\ek$_ps1\\e\\\\\\]"
			;;
		esac
		unset _ps1
		;;
	*)
		;;
	esac
elif [ -n "$ZSH_VERSION" ]; then
	PS1='%m%# '
else
	PS1="`hostname -s`\\\$ "
fi

# Keep a large history to avoid losing commands
HISTSIZE=524288
HISTFILESIZE=$HISTSIZE
[ -z "$ZSH_VERSION" ] || SAVEHIST=$HISTSIZE
# Use a non-default history file to avoid truncation by
# shells that do not respect our custom history size
if [ -n "$KSH_VERSION" ]; then
	HISTFILE="$HOME/.ksh_history"
elif [ -n "$ZSH_VERSION" ]; then
	HISTFILE="$HOME/.zsh_history2"
elif [ -n "$BASH_VERSION" ]; then
	HISTFILE="$HOME/.bash_history2"
else
	HISTFILE="$HOME/.sh_history"
fi

if [ -x /opt/homebrew/bin/brew ]; then
	if [ -n "$ZSH_VERSION" ]; then
		_cached_eval brew-shellenv /opt/homebrew/bin/brew shellenv zsh
	else
		eval "$(/opt/homebrew/bin/brew shellenv)"
	fi
fi

# libpq is keg-only, so its binaries (psql, pg_dump, ...) are not linked
if [ -d "${HOMEBREW_PREFIX:-}/opt/libpq/bin" ]; then
	PATH="$HOMEBREW_PREFIX/opt/libpq/bin:$PATH"
fi

# https://github.com/rbenv/rbenv
if [ -d "$HOME/.rbenv/bin" ]; then
	PATH="$HOME/.rbenv/bin:$PATH"
	eval "$(rbenv init -)"
elif command -v ruby >/dev/null; then
	# Avoid spawning ruby (~60ms): look for the user gem bindir directly and
	# only ask ruby when it does not exist yet.
	_ruby_path=
	[ -z "$ZSH_VERSION" ] || setopt null_glob
	for _d in "$HOME"/.local/share/gem/ruby/*/bin "$HOME"/.gem/ruby/*/bin; do
		[ ! -d "$_d" ] || _ruby_path=$_d
	done
	[ -z "$ZSH_VERSION" ] || unsetopt null_glob
	[ -n "$_ruby_path" ] || _ruby_path="$(ruby -e 'puts Gem.bindir(Gem.user_dir)')"
	[ -z "$_ruby_path" ] || PATH="$_ruby_path:$PATH"
	unset _ruby_path _d
fi

if command -v fnm >/dev/null; then # https://github.com/Schniz/fnm
	eval "$(fnm env --use-on-cd)"
elif [ -d "$HOME/.nvm" -a -r "$NVM_DIR/nvm.sh" ]; then
	export NVM_DIR="$HOME/.nvm"
	. "$NVM_DIR/nvm.sh"
	if [ -n "$BASH_VERSION" -a -s "$NVM_DIR/bash_completion" ]; then
		. "$NVM_DIR/bash_completion"
	fi
fi

mkcd()
{
	mkdir -p "$@" && cd "$@"
}

# Load local shell resources.
[ ! -r "$HOME/.shrc-local" ] || . "$HOME/.shrc-local"

