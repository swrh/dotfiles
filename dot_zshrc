# .zshrc

[[ ! -r "$HOME/.shrc" ]] || . "$HOME/.shrc"

# Skip if not running interactively
[ ! -z "${PS1}" -o "${-#*i}" != "${-}" ] || return 0

[[ ! -r "$HOME/.iterm2_shell_integration.zsh" ]] || . "$HOME/.iterm2_shell_integration.zsh"

setopt HIST_FIND_NO_DUPS	# skip duplicates when navigating with UP arrow
setopt HIST_IGNORE_ALL_DUPS	# remove older duplicate when a new one is added
setopt HIST_IGNORE_DUPS		# skip saving if same as previous command
setopt HIST_IGNORE_SPACE	# don't save commands that start with a space
setopt HIST_SAVE_NO_DUPS	# don't write duplicates to the history file
setopt INTERACTIVE_COMMENTS	# allow # comments on the command line

autoload -Uz compinit
compinit

if which fzf >/dev/null; then
	eval "$(fzf --zsh)"
elif which tv >/dev/null; then
	eval "$(tv init zsh)"
fi

if which starship >/dev/null; then
	eval "$(starship init zsh)"
fi

# ^G to edit buffer in $EDITOR (like vi's `v` in bash vi-mode)
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd '^G' edit-command-line

# Load local zsh shell resources.
[[ ! -r "$HOME/.zshrc-local" ]] || . "$HOME/.zshrc-local"

